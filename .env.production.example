APP_NAME="Apart Care"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://apartcare.site
APP_BIND_IP=127.0.0.1
APP_PORT=8080
BOOST_BROWSER_LOGS_WATCHER=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=apart_care
DB_USERNAME=apart_care
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@apartcare.site
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
TECHNICIAN_NAME="Teknisi Demo"
TECHNICIAN_EMAIL=teknisi@apartcare.site
TECHNICIAN_PHONE=081234567891
TECHNICIAN_PASSWORD=replace-with-a-different-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=apartcare.site
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@apartcare.site
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Engine unofficial untuk prototipe/capstone. Gunakan nomor WhatsApp khusus.
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=http://whatsapp:3000
WHATSAPP_API_TOKEN=replace-with-at-least-32-random-characters
